---
import BaseLayout from './BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';

interface CTA {
  text: string;
  href: string;
  style: 'primary' | 'secondary';
}

interface Hero {
  heading: string;
  subheading?: string;
  backgroundImage: string;
  cta?: CTA[];
  height?: string;
  contentOffset?: string;
}

interface Props {
  title: string;
  description?: string;
  hero?: Hero;
  pageWidth?: 'narrow' | 'wide';
  showTitle?: boolean;
  /** Share image override, site-relative. */
  image?: string;
  /** Keep this page out of the search index. */
  noindex?: boolean;
  /** schema.org node(s) merged into the site-wide @graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Redrock Strategic Advisors',
  hero,
  pageWidth = 'wide',
  showTitle = true,
  image,
  noindex,
  jsonLd,
} = Astro.props;

const containerClass = pageWidth === 'narrow' ? 'container-narrow' : 'container-wide';
const hasHero = !!hero;
---

<BaseLayout
  title={`${title} | Redrock Strategic Advisors`}
  pageTitle={title}
  description={description}
  image={image}
  noindex={noindex}
  jsonLd={jsonLd}
>
  {hasHero && (
    <section
      class="page-hero"
      style={hero!.height ? `--hero-mobile: ${hero!.height};` : undefined}
    >
      <HeroImage src={hero!.backgroundImage} />
      <div
        class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-4"
        style={hero!.contentOffset ? `padding-top: ${hero!.contentOffset};` : undefined}
      >
        <h1 class="text-white mb-4">{hero!.heading}</h1>
        {hero!.subheading && (
          <p class="text-xl max-w-2xl lg:max-w-3xl mb-0 text-white/90">{hero!.subheading}</p>
        )}
        {hero!.cta && hero!.cta.length > 0 && (
          <div class="flex gap-4 mt-8">
            {hero!.cta.map((btn) => (
              <a href={btn.href} class={btn.style === 'secondary' ? 'btn-secondary' : 'btn-primary'}>
                {btn.text}
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {!hasHero && <div style="padding-top: 120px;"></div>}

  <main class={`${containerClass} py-16`} style="min-height: 60vh;">
    {!hasHero && showTitle && <h1 class="mb-8">{title}</h1>}
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>
  </main>
</BaseLayout>
