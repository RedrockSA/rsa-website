---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingModule from '../components/reading/ReadingModule.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { sortedCommentary } from '../data/commentary';
import { READING_LIST_ALL } from '../utils/shelves';

// =====================================================================
//  INSIGHTS PAGE DATA
//
//  Company news comes from src/content/news/, deal commentary from
//  src/data/commentary.ts, and the reading module from src/data/books.csv
//  (via `npm run generate:books`). Nothing on this page is hand-listed
//  any more - edit the source, not this file.
//
//  The two top sections show the latest PREVIEW_COUNT items, each with a
//  "More" link to its own archive page.
// =====================================================================
const PREVIEW_COUNT = 2;

const allNews = await getCollection('news');
const companyNews = allNews
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((article) => ({
    headline: article.data.title,
    link: `/about/newsroom/${article.slug}`,
  }));

// Reading module: most recently read first. Books with no date_read sort
// after everything that has one, then alphabetically among themselves.
const allBooks = await getCollection('books');
function byRecency(a: CollectionEntry<'books'>, b: CollectionEntry<'books'>) {
  const ad = a.data.dateRead;
  const bd = b.data.dateRead;
  if (ad && bd) return bd.valueOf() - ad.valueOf();
  if (ad && !bd) return -1;
  if (!ad && bd) return 1;
  return a.data.title.localeCompare(b.data.title);
}
const books = [...allBooks].sort(byRecency);
const commentary = sortedCommentary();
---

<BaseLayout title="Insights | Redrock Strategic Advisors" description="Learnings, reading, and deal insights from Redrock Strategic Advisors.">

  <!-- Hero section -->
  <section
    class="page-hero"
    style="background-image: url('/iStock-512693445-Adj.webp');"
  >
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-4">
      <h1 class="text-white mb-4">Insights for Business Owners &amp; Executives.</h1>
      <p class="text-xl max-w-2xl text-white/90 italic">Learnings, reading, and deal insights from Redrock.</p>
    </div>
  </section>

  <main class="container-narrow py-16">
    <div class="prose prose-lg max-w-none mb-8">
      <h3><strong>Redrock</strong> looks to provide proprietary insights from what we're reading, seeing and other firm developments.</h3>
    </div>

    <div class="insights-grid">
      <!-- LEFT COLUMN -->
      <div class="left-column">
        <section>
          <h3 class="text-xl font-bold text-secondary-900 pb-2 border-b border-[#334155]">Company News &amp; Events</h3>
          <div style="height: 1rem;"></div>
          <ul class="insights-list space-y-5">
            {companyNews.slice(0, PREVIEW_COUNT).map((item) => (
              <li class="text-secondary-800">
                <span class="font-semibold">{item.headline}</span>
                {" "}
                <a href={item.link} class="text-[#C80026] text-sm">[Read More]</a>
              </li>
            ))}
          </ul>
          {companyNews.length > PREVIEW_COUNT && (
            <p class="mt-6">
              <a href="/about/newsroom" class="more-button">More news &amp; events</a>
            </p>
          )}
        </section>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="right-column">
        <section>
          <h3 class="text-xl font-bold text-secondary-900 pb-2 border-b border-[#334155]">Deal Market Commentary</h3>
          <div style="height: 1rem;"></div>
          <ul class="insights-list space-y-5">
            {commentary.slice(0, PREVIEW_COUNT).map((item) => (
              <li class="text-secondary-800">
                <span class="font-semibold">{item.source} | {item.title}</span>
                {" "}
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-[#C80026] text-sm">[Read More]</a>
              </li>
            ))}
          </ul>
          {commentary.length > PREVIEW_COUNT && (
            <p class="mt-6">
              <a href="/insights/commentary" class="more-button">More commentary</a>
            </p>
          )}
        </section>
      </div>
    </div>

    <!-- WHAT REDROCK'S READING -->
    <section class="mt-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-[#334155] pb-2">
        <h3 class="text-xl font-bold text-secondary-900">Redrock Reading List</h3>
        <a href={READING_LIST_ALL} class="text-[#C80026] text-sm">See expanded view &rarr;</a>
      </div>
      <p class="mt-4 mb-10 max-w-3xl italic text-secondary-700">
        A curated list of books we've read and recommend, spanning the leadership,
        strategy, and decision-making topics that matter most to business owners
        and executives.
      </p>

      <ReadingModule books={books} expandedHref={READING_LIST_ALL} />
    </section>
  </main>
</BaseLayout>

<style>
  .insights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .insights-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .insights-list {
    list-style: disc;
    padding-left: 1.1em;
    margin-left: -0.1em;
  }

  .more-button {
    display: inline-block;
    border: 1px solid #cbd5e1;
    border-radius: 9999px;
    padding: 0.3rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #334155;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .more-button:hover {
    border-color: #C80026;
    color: #C80026;
  }
</style>
