---
/**
 * /insights/commentary — the full Deal Market Commentary archive.
 *
 * Modelled on the Newsroom page: Insights shows the latest two, this carries
 * the rest. Edit src/data/commentary.ts, not this file.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortedCommentary, formatCommentaryDate } from '../../data/commentary';

const items = sortedCommentary();
---

<BaseLayout
  title="Deal Market Commentary | Redrock Strategic Advisors"
  description="Market research, deal activity, and commentary Redrock Strategic Advisors is tracking."
>
  <!-- Hero clears the fixed 85px header, matching every other page on the site. -->
  <section
    class="page-hero"
    style="background-image: url('/iStock-512693445-Adj.jpg');"
  >
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-4">
      <h1 class="text-white mb-4">Deal Market Commentary</h1>
      <p class="text-xl max-w-2xl text-white/90 italic">What we're reading on the market.</p>
    </div>
  </section>

  <main class="container-narrow py-16">
    <p class="mb-6">
      <a href="/insights" class="text-sm" style="color:#C80026;">&larr; Back to Insights</a>
    </p>
    <p class="mb-12 max-w-3xl text-secondary-700">
      Research, outlooks, and market activity we're tracking. Updated quarterly.
    </p>

    <ul class="flex flex-col">
      {items.map((item) => (
        <li class="border-b border-secondary-200 py-5">
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="group block">
            <span class="mb-1 flex flex-wrap items-baseline gap-x-3">
              <span class="text-xs font-bold uppercase tracking-wider text-secondary-400">
                {item.source}
              </span>
              {item.date && (
                <span class="text-xs text-secondary-400">{formatCommentaryDate(item.date)}</span>
              )}
            </span>
            <span class="font-semibold text-secondary-800 group-hover:text-[#C80026]">
              {item.title}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-sm text-secondary-500">{items.length} items</p>
  </main>
</BaseLayout>
