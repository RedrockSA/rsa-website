---
/**
 * /insights/books — the Redrock Reading List.
 *
 * All 110 books render once into the static HTML, so crawlers see the whole
 * list; the controls only change which are visible and in what order.
 *
 * PERFORMANCE: filtering and sorting run imperatively in one DOM pass rather
 * than through a reactive binding per book. An earlier version put x-show on
 * all 110 tiles, each re-parsing a JSON literal on every state change, so
 * merely opening a dropdown re-evaluated 110 expressions and felt sluggish.
 * Alpine now drives only the six controls; a single apply() reads
 * pre-parsed data and sets `hidden` plus a CSS `order`.
 *
 * NOTE: the client script assigns to `window` deliberately. Astro's
 * define:vars wraps a script in an IIFE, so a bare function declaration
 * stays private and Alpine can never resolve x-data.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CoverTile from '../../../components/reading/CoverTile.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { facetLabel } from '../../../utils/shelves';
import HeroImage from '../../../components/HeroImage.astro';

const books = await getCollection('books');

function facetsOf(b: CollectionEntry<'books'>): Record<string, string[]> {
  const d = b.data;
  return {
    primary: d.primaryCategory ? [d.primaryCategory] : [],
    secondary: d.secondaryCategories,
    topic: d.topics,
    geography: d.geography ? [d.geography] : [],
    type: [d.type],
  };
}

/**
 * One lowercase haystack per book, so the box can match anything the CSV
 * holds - title, subtitle, author, publisher, year, ISBN, and every category.
 * Category slugs go in twice, raw and through facetLabel, so a visitor finds
 * the same shelf whether they type "memoir-and-biography" or "Memoir &".
 */
function searchText(b: CollectionEntry<'books'>): string {
  const d = b.data;
  const slugs = [
    d.primaryCategory,
    d.geography,
    d.type,
    ...d.topics,
    ...d.secondaryCategories,
  ].filter(Boolean) as string[];

  return [
    d.title, d.subtitle, d.author, d.authorLastName, d.publisher,
    d.yearPublished, d.originalPublicationYear, d.oneLiner,
    d.isbn13, d.isbn10, d.asin,
    ...slugs,
    ...slugs.map(facetLabel),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
}

// Display order of the filter buttons, left to right.
// Display order, left to right. The three category facets are a hierarchy:
// one primary shelf per book, a few broad secondary buckets, then granular topics.
const FACETS = [
  { key: 'type', label: 'Type' },
  { key: 'primary', label: 'Primary Category' },
  { key: 'secondary', label: 'Secondary Category' },
  { key: 'topic', label: 'Topics' },
  { key: 'geography', label: 'Geography' },
];

const SORTS = [
  { key: 'added', label: 'Date added' },
  { key: 'published', label: 'Published date' },
  { key: 'title', label: 'Alphabetical' },
];

const tallies: Record<string, Map<string, number>> = {};
for (const b of books) {
  for (const [facet, values] of Object.entries(facetsOf(b))) {
    tallies[facet] ??= new Map();
    for (const v of values) tallies[facet].set(v, (tallies[facet].get(v) ?? 0) + 1);
  }
}

const facetGroups = FACETS.map((f) => ({
  ...f,
  options: [...(tallies[f.key] ?? new Map())]
    .map(([value, count]) => ({ value, count, label: facetLabel(value) }))
    .sort((a, b) => a.label.localeCompare(b.label)),
}));

const labelMap: Record<string, Record<string, string>> = {};
for (const g of facetGroups) {
  labelMap[g.key] = Object.fromEntries(g.options.map((o) => [o.value, o.label]));
}

// Document order is newest-added first, so the page is already in its
// default sort before any JS runs.
const sorted = [...books].sort(
  (a, b) => (b.data.dateAdded?.valueOf() ?? 0) - (a.data.dateAdded?.valueOf() ?? 0)
);
---

<BaseLayout
  title="Reading List | Redrock Strategic Advisors"
  description="A curated list of books we have read and recommend, spanning the leadership, strategy, and decision-making topics that matter most to business owners and executives."
>
  <section class="page-hero">
    <HeroImage src="/iStock-512693445-Adj.webp" />
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-4">
      <h1 class="text-white mb-4">Redrock Reading List</h1>
      <p class="text-xl max-w-2xl lg:max-w-3xl text-white/90 italic">Books we recommend to founders and executives.</p>
    </div>
  </section>

  <main class="container-narrow py-16" x-data="readingList()">
    <p class="mb-6">
      <a href="/insights/" class="text-sm" style="color:#C80026;">&larr; Back to Insights</a>
    </p>
    <p class="mb-8 max-w-3xl text-secondary-700">
      A curated list of books we have read and recommend, spanning the leadership,
      strategy, and decision-making topics that matter most to business owners
      and executives.
    </p>

    <!-- Search left, everything else grouped right. Two flex children rather
         than three, so a narrow viewport drops the whole right-hand cluster
         onto its own line and leaves the search box alone on top. -->
    <div class="control-row">
      <div class="search-group">
        <svg class="search-icon" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <path d="M10.6 10.6 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <label class="sr-only" for="book-search">Search the reading list</label>
        <!-- The prompt clears on focus rather than on first keystroke, so the
             box is empty the moment the visitor starts typing. -->
        <input
          id="book-search"
          type="search"
          class="search-input"
          autocomplete="off"
          placeholder="Type here or use filters below"
          x-bind:value="query"
          x-bind:placeholder="focused ? '' : 'Type here or use filters below'"
          x-on:focus="focused = true"
          x-on:blur="focused = false"
          x-on:input="onQuery($event.target.value)"
        />
      </div>

      <div class="control-right">
        <div class="reset-group">
          <button type="button" class="reset-link" x-on:click="clearAll()" x-bind:disabled="!hasSelection">
            Clear selection
          </button>
          <span class="reset-sep">/</span>
          <button
            type="button"
            class="reset-link"
            x-bind:class="showAll && 'reset-link--on'"
            x-on:click="toggleShowAll()"
          >
            <span x-text="showAll ? 'Showing all ' + total + ' books' : 'Show all ' + total + ' books'"
            >Show all {books.length} books</span>
          </button>
        </div>

        <div class="sort-group dropdown dropdown--right" x-on:click.outside="if (open === 'sort') open = null">
          <span class="sort-label">Sort by</span>
          <button type="button" class="sort-button"
                  x-on:click="open = open === 'sort' ? null : 'sort'">
            <span x-text="sortLabel">Date added</span>
            <svg class="dd-caret" viewBox="0 0 12 8" aria-hidden="true"
                 x-bind:style="open === 'sort' ? 'transform:rotate(180deg)' : ''">
              <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="dd-panel dd-panel--right" x-show="open === 'sort'" x-cloak>
            {SORTS.map((s) => (
              <button type="button" class="dd-option"
                      x-bind:class={`sort === '${s.key}' && 'dd-option--on'`}
                      x-on:click={`setSort('${s.key}')`}>{s.label}</button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ── Filter dropdowns ───────────────────────────────────────── -->
    <div class="filter-bar">
      {facetGroups.map((group) => (
        <div class="dropdown" x-on:click.outside={`if (open === '${group.key}') open = null`}>
          <button
            type="button"
            class="dd-button"
            x-bind:class={`sel.${group.key}.length && !showAll && 'dd-button--set'`}
            x-on:click={`open = open === '${group.key}' ? null : '${group.key}'`}
            x-bind:aria-expanded={`open === '${group.key}'`}
          >
            <span class="dd-label">{group.label}</span>
            <span class="dd-value">
              <span x-text={`valueLabel('${group.key}')`}>Select</span>
              <svg class="dd-caret" viewBox="0 0 12 8" aria-hidden="true"
                   x-bind:style={`open === '${group.key}' ? 'transform:rotate(180deg)' : ''`}>
                <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
          </button>

          <!-- x-cloak keeps every panel closed until Alpine boots, so the
               page never paints with all the dropdowns expanded. -->
          <div class="dd-panel" x-show={`open === '${group.key}'`} x-cloak>
            <button type="button" class="dd-option dd-option--any"
                    x-on:click={`clearFacet('${group.key}')`}>Any {group.label.toLowerCase()}</button>
            {group.options.map((o) => (
              <button
                type="button"
                class="dd-option"
                x-bind:class={`isOn('${group.key}', ${JSON.stringify(o.value)}) && 'dd-option--on'`}
                x-on:click={`toggle('${group.key}', ${JSON.stringify(o.value)})`}
              >
                <span class="dd-box" aria-hidden="true">&check;</span>
                <span>{o.label}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ── Results ────────────────────────────────────────────────── -->
    <h2 class="results-heading">
      <span x-text="headingText">All books</span>
      <span class="results-count" x-text="countText">{books.length} books</span>
    </h2>

    <div class="cover-grid" id="book-grid" style="--tile-h: 150px;">
      {sorted.map((book) => (
        <div
          class="tile"
          data-facets={JSON.stringify(facetsOf(book))}
          data-added={book.data.dateAdded ? book.data.dateAdded.toISOString().slice(0, 10) : ''}
          data-published={String(book.data.originalPublicationYear ?? book.data.yearPublished ?? '')}
          data-title={book.data.title.replace(/^(the|a|an)\s+/i, '').toLowerCase()}
          data-search={searchText(book)}
        >
          <CoverTile
            title={book.data.title}
            author={book.data.author}
            slug={book.slug}
            coverImage={book.data.coverImage}
            coverWidth={book.data.coverWidth}
            coverHeight={book.data.coverHeight}
          />
        </div>
      ))}
    </div>

    <p class="no-results" x-show="shown === 0" x-cloak>
      <span x-text="query.trim() ? 'No books match \u201C' + query.trim() + '\u201D.' : 'No books match that combination.'"
      >No books match that combination.</span>
      <button type="button" class="reset-link" x-on:click="clearAll()">Clear selection</button>
    </p>
  </main>

  <script is:inline define:vars={{ labelMap, facetKeys: FACETS, sortKeys: SORTS, total: books.length }}>
    window.readingList = function () {
      // Arrays, so several values can be active per facet. Seeded from the
      // query string when present - that's how "More…", "See all" and a
      // book's shelf link arrive with a filter already applied. With no
      // query string the page opens on the full list.
      const params = new URLSearchParams(location.search);
      const sel = {};
      let fromUrl = false;
      facetKeys.forEach((f) => {
        const raw = params.get(f.key);
        sel[f.key] = raw ? raw.split(',').map((v) => v.trim()).filter(Boolean) : [];
        if (sel[f.key].length) fromUrl = true;
      });

      return {
        open: null,
        showAll: !fromUrl,
        sort: 'added',
        query: '',
        focused: false,
        sel,
        shown: total,
        total: total,
        tiles: [],

        init() {
          // Parse each tile once, not on every state change.
          this.tiles = Array.from(document.querySelectorAll('#book-grid .tile')).map((el) => ({
            el,
            facets: JSON.parse(el.dataset.facets),
            added: el.dataset.added || '',
            published: parseInt(el.dataset.published, 10) || 0,
            title: el.dataset.title || '',
            search: el.dataset.search || '',
          }));
          this.apply();
        },

        isOn(key, value) {
          return this.sel[key].includes(value);
        },
        toggle(key, value) {
          const i = this.sel[key].indexOf(value);
          if (i === -1) this.sel[key].push(value);
          else this.sel[key].splice(i, 1);
          this.showAll = false;
          this.apply();          // panel stays open so several can be picked
        },
        clearFacet(key) {
          this.sel[key] = [];
          this.showAll = false;
          this.open = null;
          this.apply();
        },
        clearAll() {
          facetKeys.forEach((f) => (this.sel[f.key] = []));
          this.query = '';
          this.showAll = false;
          this.open = null;
          this.apply();
        },
        onQuery(value) {
          this.query = value;
          // "Showing all N books" would contradict a narrowed result set.
          if (value.trim()) this.showAll = false;
          this.apply();
        },
        toggleShowAll() {
          this.showAll = !this.showAll;
          this.open = null;
          this.apply();
        },
        setSort(key) {
          this.sort = key;
          this.open = null;
          this.apply();
        },

        // `words` is tokenised once per pass by apply(), not per tile. Every
        // word must appear somewhere in the tile's haystack, so "arnold be"
        // narrows rather than widens. Search applies even when showing all.
        matches(t, words) {
          for (const w of words) if (!t.search.includes(w)) return false;
          if (this.showAll) return true;
          for (const f of facetKeys) {
            const want = this.sel[f.key];
            if (!want.length) continue;
            const has = t.facets[f.key] || [];
            if (!want.some((v) => has.includes(v))) return false;
          }
          return true;
        },

        // One pass: set visibility, then assign CSS order for the sort.
        apply() {
          const words = this.query.trim().toLowerCase().split(/\s+/).filter(Boolean);
          const visible = [];
          for (const t of this.tiles) {
            const ok = this.matches(t, words);
            t.el.hidden = !ok;
            if (ok) visible.push(t);
          }
          const cmp = {
            added: (a, b) => b.added.localeCompare(a.added),
            published: (a, b) => b.published - a.published,
            title: (a, b) => a.title.localeCompare(b.title),
          }[this.sort];
          visible.sort(cmp);
          visible.forEach((t, i) => (t.el.style.order = i));
          this.shown = visible.length;
        },

        get hasSelection() {
          return !!this.query.trim() || facetKeys.some((f) => this.sel[f.key].length);
        },
        get countText() {
          return this.shown + (this.shown === 1 ? ' book' : ' books');
        },
        get sortLabel() {
          const s = sortKeys.find((x) => x.key === this.sort);
          return s ? s.label : '';
        },
        valueLabel(key) {
          if (this.showAll) return 'Select';
          const vals = this.sel[key];
          if (!vals.length) return 'Select';
          if (vals.length === 1) return (labelMap[key] || {})[vals[0]] || vals[0];
          return vals.length + ' selected';
        },
        get headingText() {
          const parts = [];
          if (this.query.trim()) parts.push('\u201C' + this.query.trim() + '\u201D');
          if (!this.showAll) {
            for (const f of facetKeys) {
              for (const v of this.sel[f.key]) {
                parts.push((labelMap[f.key] || {})[v] || v);
              }
            }
          }
          return parts.length ? parts.join(' + ') : 'All books';
        },
      };
    };
  </script>

  <script>
    import Alpine from 'alpinejs';
    window.Alpine = Alpine;
    Alpine.start();
  </script>
</BaseLayout>

<style>
  [x-cloak] { display: none !important; }

  .control-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0.75rem;
  }

  /* flex: none so the search box can never squeeze these onto two lines. */
  .reset-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    flex: none;
  }
  .reset-sep { color: #cbd5e1; }
  .reset-link {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #C80026;
    cursor: pointer;
  }
  .reset-link { white-space: nowrap; }
  .reset-link:hover:not(:disabled) { text-decoration: underline; }
  .reset-link:disabled { color: #cbd5e1; cursor: default; }
  .reset-link--on { color: #0f172a; text-decoration: underline; }

  /* Sits with the reset links rather than above the filter bar, so the row
     reads as one set of controls: search here, or narrow with the dropdowns. */
  .search-group {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 1 20rem;
    min-width: 11rem;
  }

  /* The reset links and the sort control travel together, right-aligned, and
     wrap as one unit rather than breaking apart mid-row. */
  .control-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem 1.5rem;
    margin-left: auto;
  }

  /* Too narrow to share the line - the box takes the full top row. */
  @media (max-width: 720px) {
    .search-group { flex: 1 1 100%; }
    .control-right { justify-content: flex-start; margin-left: 0; }
  }
  .search-icon {
    position: absolute;
    left: 0.6rem;
    width: 0.85rem;
    height: 0.85rem;
    color: #94a3b8;
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.35rem 0.6rem 0.35rem 1.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.3rem;
    background: #fff;
    font-size: 0.8rem;
    color: #0f172a;
    transition: border-color 120ms ease;
  }
  .search-input::placeholder { color: #94a3b8; }
  .search-input:hover { border-color: #94a3b8; }
  .search-input:focus { outline: none; border-color: #C80026; }
  .search-input::-webkit-search-cancel-button { cursor: pointer; }

  /* Deliberately unboxed and set at the reset-link size, so sorting reads as
     a minor control rather than a sixth filter. */
  .sort-group {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.8rem;
  }
  .sort-label { color: #94a3b8; }
  .sort-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
  }
  .sort-button:hover { color: #C80026; }
  .sort-button .dd-caret { color: currentColor; }

  /* Buttons share the row equally and only wrap once they'd get too narrow. */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 1.1rem 0 1.3rem;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 2.5rem;
  }

  .dropdown { position: relative; }
  .filter-bar .dropdown { flex: 1 1 9rem; min-width: 0; }

  .dd-button {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.3rem;
    background: #fff;
    cursor: pointer;
    text-align: left;
    transition: border-color 120ms ease;
  }
  .dd-button:hover { border-color: #94a3b8; }
  .dd-button--set { border-color: #C80026; }

  .dd-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .dd-button--set .dd-label { color: #C80026; }

  .dd-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f172a;
  }
  .dd-caret { width: 0.6rem; height: 0.45rem; color: #94a3b8; transition: transform 140ms ease; flex: none; }

  .dd-panel {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.3rem);
    left: 0;
    width: max-content;
    min-width: 100%;
    max-width: 22rem;
    max-height: 17rem;
    overflow-y: auto;
    padding: 0.3rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.35rem;
    box-shadow: 0 10px 24px -8px rgb(15 23 42 / 0.28);
  }
  .dd-panel--right { left: auto; right: 0; }

  .dd-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.33rem 0.5rem;
    border: none;
    border-radius: 0.25rem;
    background: none;
    font-size: 0.82rem;
    color: #334155;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }
  .dd-option:hover { background: #f1f5f9; }
  .dd-option--on { color: #0f172a; font-weight: 600; }

  /* The box carries the selected state, so the row itself stays quiet. */
  .dd-box {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #cbd5e1;
    border-radius: 0.15rem;
    background: #fff;
    font-size: 0.62rem;
    line-height: 1;
    color: transparent;
  }
  .dd-option--on .dd-box {
    background: #C80026;
    border-color: #C80026;
    color: #fff;
  }

  .dd-option--any {
    font-style: italic;
    color: #64748b;
    border-bottom: 1px solid #f1f5f9;
    border-radius: 0;
    margin-bottom: 0.2rem;
    padding-left: 1.9rem;   /* line up with the labels beside the boxes */
  }

  .results-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #cbd5e1;
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 700;
    color: #0f172a;
  }
  .results-count {
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 400;
    color: #94a3b8;
  }

  .cover-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    align-items: flex-end;
  }
  .tile[hidden] { display: none !important; }

  .no-results {
    margin-top: 1.5rem;
    font-style: italic;
    color: #64748b;
  }
</style>
