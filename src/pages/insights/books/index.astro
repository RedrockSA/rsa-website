---
/**
 * /insights/books — the Redrock Reading List.
 *
 * All 110 books render once into the static HTML, so crawlers see the whole
 * list; the controls only change which are visible and in what order.
 *
 * PERFORMANCE: filtering and sorting run imperatively in one DOM pass rather
 * than through a reactive binding per book. An earlier version put x-show on
 * all 110 tiles, each re-parsing a JSON literal on every state change, so
 * merely opening a dropdown re-evaluated 110 expressions and felt sluggish.
 * Alpine now drives only the six controls; a single apply() reads
 * pre-parsed data and sets `hidden` plus a CSS `order`.
 *
 * NOTE: the client script assigns to `window` deliberately. Astro's
 * define:vars wraps a script in an IIFE, so a bare function declaration
 * stays private and Alpine can never resolve x-data.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CoverTile from '../../../components/reading/CoverTile.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { shelfLabel } from '../../../utils/shelves';

const books = await getCollection('books');

function facetsOf(b: CollectionEntry<'books'>): Record<string, string[]> {
  const d = b.data;
  return {
    primary: d.primaryCategory ? [d.primaryCategory] : [],
    secondary: d.secondaryCategories,
    topic: d.topics,
    geography: d.geography ? [d.geography] : [],
    type: [d.type],
  };
}

// Display order of the filter buttons, left to right.
// Display order, left to right. The three category facets are a hierarchy:
// one primary shelf per book, a few broad secondary buckets, then granular topics.
const FACETS = [
  { key: 'type', label: 'Type' },
  { key: 'primary', label: 'Primary Category' },
  { key: 'secondary', label: 'Secondary Category' },
  { key: 'topic', label: 'Topics' },
  { key: 'geography', label: 'Geography' },
];

const SORTS = [
  { key: 'added', label: 'Date added' },
  { key: 'published', label: 'Published date' },
  { key: 'title', label: 'Alphabetical' },
];

/** The category the page opens on. */
const DEFAULT_CATEGORY = 'corporate-history';

function prettify(facet: string, value: string) {
  if (facet === 'primary') return shelfLabel(value);
  return value
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/\bAnd\b/g, '&')
    .replace(/\bWwii\b/g, 'WWII')
    .replace(/\bMba\b/g, 'MBA')
    .replace(/\bUs\b/g, 'US');
}

const tallies: Record<string, Map<string, number>> = {};
for (const b of books) {
  for (const [facet, values] of Object.entries(facetsOf(b))) {
    tallies[facet] ??= new Map();
    for (const v of values) tallies[facet].set(v, (tallies[facet].get(v) ?? 0) + 1);
  }
}

const facetGroups = FACETS.map((f) => ({
  ...f,
  options: [...(tallies[f.key] ?? new Map())]
    .map(([value, count]) => ({ value, count, label: prettify(f.key, value) }))
    .sort((a, b) => a.label.localeCompare(b.label)),
}));

const labelMap: Record<string, Record<string, string>> = {};
for (const g of facetGroups) {
  labelMap[g.key] = Object.fromEntries(g.options.map((o) => [o.value, o.label]));
}

// Document order is newest-added first, so the page is already in its
// default sort before any JS runs.
const sorted = [...books].sort(
  (a, b) => (b.data.dateAdded?.valueOf() ?? 0) - (a.data.dateAdded?.valueOf() ?? 0)
);
---

<BaseLayout
  title="Reading List | Redrock Strategic Advisors"
  description="A curated list of books we've read and recommend, spanning the leadership, strategy, and decision-making topics that matter most to business owners and executives."
>
  <section class="page-hero" style="background-image: url('/iStock-512693445-Adj.webp');">
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-4">
      <h1 class="text-white mb-4">Redrock Reading List</h1>
      <p class="text-xl max-w-2xl lg:max-w-3xl text-white/90 italic">Books we recommend to founders and executives.</p>
    </div>
  </section>

  <main class="container-narrow py-16" x-data="readingList()">
    <p class="mb-6">
      <a href="/insights/" class="text-sm" style="color:#C80026;">&larr; Back to Insights</a>
    </p>
    <p class="mb-8 max-w-3xl text-secondary-700">
      A curated list of books we've read and recommend, spanning the leadership,
      strategy, and decision-making topics that matter most to business owners
      and executives.
    </p>

    <!-- Reset controls left, sort right-aligned, on one line above the rule. -->
    <div class="control-row">
      <div class="reset-group">
        <button type="button" class="reset-link" x-on:click="clearAll()" x-bind:disabled="!hasSelection">
          Clear selection
        </button>
        <span class="reset-sep">/</span>
        <button
          type="button"
          class="reset-link"
          x-bind:class="showAll && 'reset-link--on'"
          x-on:click="toggleShowAll()"
        >
          <span x-text="showAll ? 'Showing all ' + total + ' books' : 'Show all ' + total + ' books'"
          >Show all {books.length} books</span>
        </button>
      </div>

      <div class="sort-group dropdown dropdown--right" x-on:click.outside="if (open === 'sort') open = null">
        <span class="sort-label">Sort by</span>
        <button type="button" class="sort-button"
                x-on:click="open = open === 'sort' ? null : 'sort'">
          <span x-text="sortLabel">Date added</span>
          <svg class="dd-caret" viewBox="0 0 12 8" aria-hidden="true"
               x-bind:style="open === 'sort' ? 'transform:rotate(180deg)' : ''">
            <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="dd-panel dd-panel--right" x-show="open === 'sort'" x-cloak>
          {SORTS.map((s) => (
            <button type="button" class="dd-option"
                    x-bind:class={`sort === '${s.key}' && 'dd-option--on'`}
                    x-on:click={`setSort('${s.key}')`}>{s.label}</button>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Filter dropdowns ───────────────────────────────────────── -->
    <div class="filter-bar">
      {facetGroups.map((group) => (
        <div class="dropdown" x-on:click.outside={`if (open === '${group.key}') open = null`}>
          <button
            type="button"
            class="dd-button"
            x-bind:class={`sel.${group.key}.length && !showAll && 'dd-button--set'`}
            x-on:click={`open = open === '${group.key}' ? null : '${group.key}'`}
            x-bind:aria-expanded={`open === '${group.key}'`}
          >
            <span class="dd-label">{group.label}</span>
            <span class="dd-value">
              <span x-text={`valueLabel('${group.key}')`}>Select</span>
              <svg class="dd-caret" viewBox="0 0 12 8" aria-hidden="true"
                   x-bind:style={`open === '${group.key}' ? 'transform:rotate(180deg)' : ''`}>
                <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
          </button>

          <!-- x-cloak keeps every panel closed until Alpine boots, so the
               page never paints with all the dropdowns expanded. -->
          <div class="dd-panel" x-show={`open === '${group.key}'`} x-cloak>
            <button type="button" class="dd-option dd-option--any"
                    x-on:click={`clearFacet('${group.key}')`}>Any {group.label.toLowerCase()}</button>
            {group.options.map((o) => (
              <button
                type="button"
                class="dd-option"
                x-bind:class={`isOn('${group.key}', ${JSON.stringify(o.value)}) && 'dd-option--on'`}
                x-on:click={`toggle('${group.key}', ${JSON.stringify(o.value)})`}
              >
                <span class="dd-box" aria-hidden="true">&check;</span>
                <span>{o.label}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ── Results ────────────────────────────────────────────────── -->
    <h2 class="results-heading">
      <span x-text="headingText">All books</span>
      <span class="results-count"><span x-text="shown">{books.length}</span> books</span>
    </h2>

    <div class="cover-grid" id="book-grid" style="--tile-h: 150px;">
      {sorted.map((book) => (
        <div
          class="tile"
          data-facets={JSON.stringify(facetsOf(book))}
          data-added={book.data.dateAdded ? book.data.dateAdded.toISOString().slice(0, 10) : ''}
          data-published={String(book.data.originalPublicationYear ?? book.data.yearPublished ?? '')}
          data-title={book.data.title.replace(/^(the|a|an)\s+/i, '').toLowerCase()}
        >
          <CoverTile
            title={book.data.title}
            author={book.data.author}
            slug={book.slug}
            coverImage={book.data.coverImage}
            coverWidth={book.data.coverWidth}
            coverHeight={book.data.coverHeight}
          />
        </div>
      ))}
    </div>

    <p class="no-results" x-show="shown === 0" x-cloak>
      No books match that combination.
      <button type="button" class="reset-link" x-on:click="clearAll()">Clear selection</button>
    </p>
  </main>

  <script is:inline define:vars={{ labelMap, facetKeys: FACETS, sortKeys: SORTS, defaultCategory: DEFAULT_CATEGORY, total: books.length }}>
    window.readingList = function () {
      return {
        open: null,
        showAll: false,
        sort: 'added',
        // Arrays, so several values can be active per facet. Seeded from the
        // query string when present - that's how "More…", "See all" and a
        // book's shelf link arrive with a filter already applied.
        sel: (() => {
          const params = new URLSearchParams(location.search);
          const s = {};
          let fromUrl = false;
          facetKeys.forEach((f) => {
            const raw = params.get(f.key);
            s[f.key] = raw ? raw.split(',').map((v) => v.trim()).filter(Boolean) : [];
            if (s[f.key].length) fromUrl = true;
          });
          // ?all arrives from "See expanded view" - show everything rather
          // than dropping into the default category.
          if (!fromUrl && !params.has('all')) s.primary = [defaultCategory];
          return s;
        })(),
        shown: total,
        total: total,
        tiles: [],

        init() {
          // Parse each tile once, not on every state change.
          this.tiles = Array.from(document.querySelectorAll('#book-grid .tile')).map((el) => ({
            el,
            facets: JSON.parse(el.dataset.facets),
            added: el.dataset.added || '',
            published: parseInt(el.dataset.published, 10) || 0,
            title: el.dataset.title || '',
          }));
          this.apply();
        },

        isOn(key, value) {
          return this.sel[key].includes(value);
        },
        toggle(key, value) {
          const i = this.sel[key].indexOf(value);
          if (i === -1) this.sel[key].push(value);
          else this.sel[key].splice(i, 1);
          this.showAll = false;
          this.apply();          // panel stays open so several can be picked
        },
        clearFacet(key) {
          this.sel[key] = [];
          this.showAll = false;
          this.open = null;
          this.apply();
        },
        clearAll() {
          facetKeys.forEach((f) => (this.sel[f.key] = []));
          this.showAll = false;
          this.open = null;
          this.apply();
        },
        toggleShowAll() {
          this.showAll = !this.showAll;
          this.open = null;
          this.apply();
        },
        setSort(key) {
          this.sort = key;
          this.open = null;
          this.apply();
        },

        matches(t) {
          if (this.showAll) return true;
          for (const f of facetKeys) {
            const want = this.sel[f.key];
            if (!want.length) continue;
            const has = t.facets[f.key] || [];
            if (!want.some((v) => has.includes(v))) return false;
          }
          return true;
        },

        // One pass: set visibility, then assign CSS order for the sort.
        apply() {
          const visible = [];
          for (const t of this.tiles) {
            const ok = this.matches(t);
            t.el.hidden = !ok;
            if (ok) visible.push(t);
          }
          const cmp = {
            added: (a, b) => b.added.localeCompare(a.added),
            published: (a, b) => b.published - a.published,
            title: (a, b) => a.title.localeCompare(b.title),
          }[this.sort];
          visible.sort(cmp);
          visible.forEach((t, i) => (t.el.style.order = i));
          this.shown = visible.length;
        },

        get hasSelection() {
          return facetKeys.some((f) => this.sel[f.key].length);
        },
        get sortLabel() {
          const s = sortKeys.find((x) => x.key === this.sort);
          return s ? s.label : '';
        },
        valueLabel(key) {
          if (this.showAll) return 'Select';
          const vals = this.sel[key];
          if (!vals.length) return 'Select';
          if (vals.length === 1) return (labelMap[key] || {})[vals[0]] || vals[0];
          return vals.length + ' selected';
        },
        get headingText() {
          if (this.showAll) return 'All books';
          const parts = [];
          for (const f of facetKeys) {
            for (const v of this.sel[f.key]) {
              parts.push((labelMap[f.key] || {})[v] || v);
            }
          }
          return parts.length ? parts.join(' + ') : 'All books';
        },
      };
    };
  </script>

  <script>
    import Alpine from 'alpinejs';
    window.Alpine = Alpine;
    Alpine.start();
  </script>
</BaseLayout>

<style>
  [x-cloak] { display: none !important; }

  .control-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0.75rem;
  }

  .reset-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
  }
  .reset-sep { color: #cbd5e1; }
  .reset-link {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #C80026;
    cursor: pointer;
  }
  .reset-link:hover:not(:disabled) { text-decoration: underline; }
  .reset-link:disabled { color: #cbd5e1; cursor: default; }
  .reset-link--on { color: #0f172a; text-decoration: underline; }

  /* Deliberately unboxed and set at the reset-link size, so sorting reads as
     a minor control rather than a sixth filter. */
  .sort-group {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.8rem;
  }
  .sort-label { color: #94a3b8; }
  .sort-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
  }
  .sort-button:hover { color: #C80026; }
  .sort-button .dd-caret { color: currentColor; }

  /* Buttons share the row equally and only wrap once they'd get too narrow. */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 1.1rem 0 1.3rem;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 2.5rem;
  }

  .dropdown { position: relative; }
  .filter-bar .dropdown { flex: 1 1 9rem; min-width: 0; }

  .dd-button {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.3rem;
    background: #fff;
    cursor: pointer;
    text-align: left;
    transition: border-color 120ms ease;
  }
  .dd-button:hover { border-color: #94a3b8; }
  .dd-button--set { border-color: #C80026; }

  .dd-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .dd-button--set .dd-label { color: #C80026; }

  .dd-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f172a;
  }
  .dd-caret { width: 0.6rem; height: 0.45rem; color: #94a3b8; transition: transform 140ms ease; flex: none; }

  .dd-panel {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.3rem);
    left: 0;
    width: max-content;
    min-width: 100%;
    max-width: 22rem;
    max-height: 17rem;
    overflow-y: auto;
    padding: 0.3rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.35rem;
    box-shadow: 0 10px 24px -8px rgb(15 23 42 / 0.28);
  }
  .dd-panel--right { left: auto; right: 0; }

  .dd-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.33rem 0.5rem;
    border: none;
    border-radius: 0.25rem;
    background: none;
    font-size: 0.82rem;
    color: #334155;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }
  .dd-option:hover { background: #f1f5f9; }
  .dd-option--on { color: #0f172a; font-weight: 600; }

  /* The box carries the selected state, so the row itself stays quiet. */
  .dd-box {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #cbd5e1;
    border-radius: 0.15rem;
    background: #fff;
    font-size: 0.62rem;
    line-height: 1;
    color: transparent;
  }
  .dd-option--on .dd-box {
    background: #C80026;
    border-color: #C80026;
    color: #fff;
  }

  .dd-option--any {
    font-style: italic;
    color: #64748b;
    border-bottom: 1px solid #f1f5f9;
    border-radius: 0;
    margin-bottom: 0.2rem;
    padding-left: 1.9rem;   /* line up with the labels beside the boxes */
  }

  .results-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #cbd5e1;
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 700;
    color: #0f172a;
  }
  .results-count {
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 400;
    color: #94a3b8;
  }

  .cover-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    align-items: flex-end;
  }
  .tile[hidden] { display: none !important; }

  .no-results {
    margin-top: 1.5rem;
    font-style: italic;
    color: #64748b;
  }
</style>
